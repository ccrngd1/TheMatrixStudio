# TheMatrix Simulation Studio - Environment Configuration Example
# Copy this file to .env and fill in your API keys

# ==================== LiteLLM Model Configuration ====================
# Any LiteLLM model string: openai/gpt-4o, anthropic/..., bedrock/..., ollama/...
LITELLM_MODEL=bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0
LITELLM_TEMPERATURE=0.7
LITELLM_MAX_TOKENS=2048

# ==================== AWS Credentials (for Bedrock) ====================
# Required for Bedrock models and Nova Canvas avatar generation.
# Option A (recommended): Bedrock API key / bearer token
AWS_BEARER_TOKEN_BEDROCK=
# Option B: classic IAM access key pair
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ==================== OpenAI ====================
OPENAI_API_KEY=

# ==================== Anthropic ====================
ANTHROPIC_API_KEY=

# ==================== Simulation Defaults ====================
MAX_MESSAGES=20

# ==================== Knowledge-base uploads ====================
# Both caps are enforced server-side. A file can be small on disk and large as
# text (PDFs especially), so the two limits are independent.
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENT_CHARS=400000

# ==================== Storage ====================
# Relative paths resolve against the checkout root, not the working directory,
# so the same database is used whichever subdirectory you start the server from.
# Absolute paths are used as given.
DATA_DIR=./data

# ==================== Server Settings (Phase 1) ====================
MATRIX_PORT=8000
MATRIX_HOST=127.0.0.1

# ==================== Multi-tenancy ====================
# Every run belongs to one user. This only decides where that user's identity
# comes from — it does NOT turn authentication on or off by itself.
#
#   single-user  no authentication; every request is the same implicit local
#                user. The default, and only defensible because MATRIX_HOST is
#                127.0.0.1. This is what the tool has always been.
#   jwt          the identity must arrive as verified claims from an API Gateway
#                authorizer; an unauthenticated request is a 401. Requires
#                something in front of the app that validates the token — the
#                app does not verify signatures itself.
#
# Verified claims take precedence in BOTH modes, so putting an authorizer in
# front starts attributing runs correctly even if this is left at the default.
AUTH_MODE=single-user

# Sweep runs left in `running` by a crash, at startup. Correct on a single
# long-lived server — those runs would otherwise report as live forever.
#
# MUST be false on Lambda or any horizontally-scaled deployment: the sweep assumes
# it is the only process, so two concurrent cold starts would each conclude the
# other's in-flight run was orphaned and mark it interrupted. That is one request
# terminating another user's live conversation.
STARTUP_SWEEP=true

# ==================== Avatar Generation ====================
# Uses a Stability text-to-image model on Bedrock (Nova Canvas is retired).
# SD3.5 Large is served from us-west-2, which can differ from your text model region.
ENABLE_AVATARS=true
AVATAR_MODEL_ID=stability.sd3-5-large-v1:0
AVATAR_REGION=us-west-2
AVATAR_ASPECT_RATIO=1:1

# Comma-separated selectable models for the UI (new-run form + in-thread picker).
# LITELLM_MODEL is always included even if omitted here. Keys stay server-side.
# AVAILABLE_MODELS=bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0,bedrock/global.anthropic.claude-sonnet-4-6,bedrock/global.anthropic.claude-opus-4-8,bedrock/amazon.nova-pro-v1:0,bedrock/us.meta.llama4-maverick-17b-instruct-v1:0
